# Trak Watch - Environment Variables

# Copy this file to .env.local and fill in your values

# Supabase (get from Settings → API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# TMDB (get from https://www.themoviedb.org/settings/api)
VITE_TMDB_API_KEY=your-tmdb-v3-api-key
VITE_TMDB_READ_ACCESS_TOKEN=your-tmdb-v4-read-access-token

# Optional: Sentry for error tracking
# VITE_SENTRY_DSN=https://xxx@sentry.io/xxx

# App URL (for OAuth redirects)
VITE_APP_URL=http://localhost:3000